# BMS — AI Bid Management System environment template
# Copy to .env and adjust. All variables are optional; defaults work for local demo.

# --- Database ---
# Dev default: SQLite file. Docker/Prod: PostgreSQL.
#
# The deployed API runs on serverless instances, so its database has to be
# shared between them. Supabase's PostgreSQL is used for that. Two parts of
# the URL matter:
#
#   <user>.<project-ref>  the database user, then the project reference.
#                          The pooler reads the pair to find the project.
#   :6543                 the transaction pooler. It is reached over IPv4 and
#                         it is meant for short-lived serverless connections.
#
# The direct host (db.<project-ref>.supabase.co) is IPv6-only, so a serverless
# instance cannot always reach it.
# BMS_DATABASE_URL=postgresql://bms_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
BMS_DATABASE_URL=sqlite:///./bms.db
# BMS_DATABASE_URL=postgresql+psycopg://bms:bms@localhost:5432/bms
# TLS mode for a database that is not the Supabase pooler.
BMS_DB_SSLMODE=require

# --- Storage (documents, raw snapshots, exports) ---
BMS_STORAGE_DIR=./storage

# --- LLM provider: mock | openrouter | openai ---
# mock    = deterministic offline engine (default). Runs the same four tasks the
#           LLM runs — rationale, extraction, risk, drafting — with no API key
#           and no network. Output is flagged simulated=True in the metrics.
# openrouter / openai = any OpenAI-compatible /chat/completions endpoint.
BMS_LLM_PROVIDER=mock
BMS_LLM_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM tuning ---
# The whole budget for one model call, retries included. It has to be shorter
# than the host's limit on a request, or a model that hangs would use up the
# entire request on its own.
BMS_LLM_TIMEOUT_SECONDS=25
# Output budget for the scoring rationale. It has to leave room for the
# model's own reasoning: a reasoning model spends its budget on thinking
# before it answers, and if the cap lands first the answer never arrives.
BMS_LLM_SCORE_MAX_TOKENS=1000
BMS_LLM_MAX_RETRIES=2
BMS_LLM_TEMPERATURE=0.2
BMS_LLM_CACHE_ENABLED=true
BMS_LLM_DRAFT_WORKERS=4

# --- Connectors ---
# true = parse local fixtures (demo). false = live fetch from portals.
BMS_FIXTURES=true
BMS_SCAN_INTERVAL_SECONDS=3600
BMS_SCHEDULER_ENABLED=false
BMS_USER_AGENT=BMS-Bot/0.1 (+https://www.ahte.com.pk)

# --- Live portal reading ---
# Only used when BMS_FIXTURES=false. See docs/05 section 11.
# Seconds allowed for one portal request. These are slow government sites.
BMS_LIVE_REQUEST_TIMEOUT=60
# Minimum seconds between two requests to the same portal.
BMS_LIVE_MIN_INTERVAL=3.0
# Retries after a failed request.
BMS_LIVE_RETRIES=2
# Listing pages walked per source in one scan.
BMS_LIVE_MAX_PAGES=3
# Detail pages read per source in one scan.
BMS_LIVE_MAX_DETAILS=2
# Seconds a source's read may spend on the network before it stops and
# returns what it has read.
BMS_LIVE_SCAN_DEADLINE=32
# Seconds allowed to open a connection to a portal.
BMS_LIVE_CONNECT_TIMEOUT=10
# Seconds a freshly started deployment may spend reading the portals before
# it serves its first request, so the dashboard is not empty.
BMS_LIVE_STARTUP_BUDGET=30
# How far back to read a portal that publishes its whole history at once.
BMS_LIVE_LOOKBACK_DAYS=60
# Whether a live read presents a browser User-Agent. NTDC answers 403 to a bot
# User-Agent, so this stays true for the portals that need it.
BMS_LIVE_BROWSER_UA=true
# Whether portal reads verify TLS certificates. On by default; turn off only
# for a portal whose certificate chain an inspection appliance breaks, and
# expect a warning in the logs for every read done without verification.
BMS_LIVE_VERIFY_TLS=true

# --- API ---
BMS_CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# The key sessions are signed with. A deployment reading the live portals
# REFUSES sign-in while this is left at the default below: the key is printed
# in the repository, so sessions signed with it are forgeable. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
BMS_SECRET_KEY=change-me-in-production
BMS_TOKEN_TTL_HOURS=12
# Password given to the seeded administrator (admin@ahte.local). On a live
# deployment this is also the documented way to change the admin password:
# set it and redeploy. With no value, a live deployment seeds no accounts at
# all rather than creating one with a password printed in the repository.
BMS_ADMIN_PASSWORD=
# Failed sign-ins allowed from one client+account before sign-ins are refused
# for a while. The limit makes password guessing slow, not impossible.
BMS_LOGIN_MAX_ATTEMPTS=10
BMS_LOGIN_WINDOW_SECONDS=300

# --- Scheduled work (serverless) ---
# A serverless deployment has no process that wakes up on its own: the daily
# scan, watchdog pass and digest are driven by a scheduled request to
# /api/cron/tick (see services/api/vercel.json). The host signs the request
# with this secret, and the API refuses cron work without it. On Vercel, set
# CRON_SECRET on the API project and the scheduler picks it up automatically:
#   gh secret set CRON_SECRET --body "$(openssl rand -hex 24)"
CRON_SECRET=

# --- Outbound email (digest and screening alerts) ---
# Without these the digest and alerts stay in the dashboard inbox. With them
# the daily ranked brief — and a same-day alert when tenders clear screening —
# go out by SMTP. Gmail (with an app password), Mailgun and SES SMTP all fit.
BMS_SMTP_HOST=
BMS_SMTP_PORT=587
BMS_SMTP_USER=
BMS_SMTP_PASSWORD=
# The From address, e.g. "AHTE BMS <bms@ahte.com.pk>".
BMS_SMTP_FROM=
# STARTTLS on the submission port. Set false for an implicit-SSL (465) server.
BMS_SMTP_USE_TLS=true
BMS_DIGEST_ENABLED=true
# Comma-separated recipients. Empty = the active admin, bid-manager and
# management accounts.
BMS_DIGEST_RECIPIENTS=
BMS_DIGEST_MAX_ITEMS=10

# --- Admin analytics ---
# AI quality analytics cover this many recent days of model calls.
BMS_AI_METRICS_WINDOW_DAYS=30

# --- Scoring defaults (A-11) ---
BMS_SCORE_ARCHIVE_THRESHOLD=40
BMS_MIN_DAYS_TO_BID=3
# The whole time one request may take, including whatever the instance had
# to do to get ready before serving it. Every phase of the work draws from
# this one budget, so a request that starts slowly does less rather than
# running past the end of its time.
BMS_REQUEST_BUDGET_SECONDS=45
# Seconds one scan may spend scoring the tenders it captured. Scoring a
# tender is what opens its review gate, so a capture that is not scored
# leaves the review queue empty.
BMS_SCORE_BUDGET_SECONDS=24
# Seconds the catch-up pass at start-up may spend scoring what the last
# capture left over. This is work done before the instance serves anything,
# so it comes out of the first request's budget.
BMS_STARTUP_SCORE_BUDGET_SECONDS=10
# Seconds one tender's model call may take before it is abandoned. A tender
# is only narrated when this much of the batch budget is still free, so the
# rest of the batch keeps moving and every tender still gets a score.
BMS_SCORE_ITEM_SECONDS=15
# Seconds the "score everything waiting" action may spend.
BMS_SCORE_PENDING_BUDGET_SECONDS=40

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
