# BMS — AI Bid Management System environment template
# Copy to .env and adjust. All variables are optional; defaults work for local demo.

# --- Database ---
# Dev default: SQLite file. Docker/Prod: PostgreSQL.
BMS_DATABASE_URL=sqlite:///./bms.db
# BMS_DATABASE_URL=postgresql+psycopg://bms:bms@localhost:5432/bms

# --- Storage (documents, raw snapshots, exports) ---
BMS_STORAGE_DIR=./storage

# --- LLM provider: mock | openrouter | openai ---
# mock    = deterministic offline engine (default). Runs the same four tasks the
#           LLM runs — rationale, extraction, risk, drafting — with no API key
#           and no network. Output is flagged simulated=True in the metrics.
# openrouter / openai = any OpenAI-compatible /chat/completions endpoint.
BMS_LLM_PROVIDER=mock
BMS_LLM_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM tuning ---
BMS_LLM_TIMEOUT_SECONDS=60
BMS_LLM_MAX_RETRIES=2
BMS_LLM_TEMPERATURE=0.2
BMS_LLM_CACHE_ENABLED=true
BMS_LLM_DRAFT_WORKERS=4

# --- Connectors ---
# true = parse local fixtures (demo). false = live fetch from portals.
BMS_FIXTURES=true
BMS_SCAN_INTERVAL_SECONDS=3600
BMS_SCHEDULER_ENABLED=false
BMS_USER_AGENT=BMS-Bot/0.1 (+contact@ahte.example)

# --- API ---
BMS_CORS_ORIGINS=http://localhost:3000

# --- Auth ---
BMS_SECRET_KEY=change-me-in-production
BMS_TOKEN_TTL_HOURS=12

# --- Scoring defaults (A-11) ---
BMS_SCORE_ARCHIVE_THRESHOLD=40
BMS_MIN_DAYS_TO_BID=3

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
